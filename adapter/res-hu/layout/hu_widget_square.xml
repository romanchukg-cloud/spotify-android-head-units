<?xml version="1.0" encoding="utf-8"?>
<!-- The square Spotify widget (from 232 x 220 dp): a cover beside the title and artist, elapsed
     and remaining time, previous / play-pause / next. HuWidgets fills it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hu_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hu_widget_card"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/hu_widget_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/hu_widget_cover"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:scaleType="fitCenter"
                android:src="@drawable/hu_widget_cover_wide" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hu_widget_title"
                    android:text="Spotify"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:textColor="@color/hu_widget_text"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/hu_widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/hu_widget_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hu_widget_times"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <Chronometer
                android:id="@+id/hu_widget_elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/hu_widget_secondary"
                android:textSize="13sp" />

            <Chronometer
                android:id="@+id/hu_widget_remaining"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/hu_widget_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/hu_widget_previous"
                android:src="@drawable/hu_widget_icon_previous"
                android:tint="@color/hu_widget_text"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:padding="14dp"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/hu_widget_play"
                android:src="@drawable/hu_widget_icon_play"
                android:tint="@color/hu_widget_bg"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/hu_widget_play"
                android:padding="19dp"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/hu_widget_next"
                android:src="@drawable/hu_widget_icon_next"
                android:tint="@color/hu_widget_text"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:padding="14dp"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hu_widget_open"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/hu_widget_logo"
            android:tint="@color/hu_widget_logo"
            android:layout_width="48dp"
            android:layout_height="48dp" />

        <TextView
            android:id="@+id/hu_widget_open_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/hu_widget_text"
            android:textSize="20sp" />
    </LinearLayout>
</FrameLayout>
