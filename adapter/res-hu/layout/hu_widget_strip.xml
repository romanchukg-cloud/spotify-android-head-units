<?xml version="1.0" encoding="utf-8"?>
<!-- The Spotify widget as a strip (from 326 x 80 dp): the cover, the title and artist (with the
     times from 400 x 90 dp), previous / play-pause / next at the end. HuWidgets fills it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hu_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hu_widget_card"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/hu_widget_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/hu_widget_cover"
            android:maxWidth="160dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/hu_widget_cover_wide" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hu_widget_title"
                android:text="Spotify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hu_widget_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hu_widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hu_widget_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/hu_widget_times"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <Chronometer
                    android:id="@+id/hu_widget_elapsed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/hu_widget_secondary"
                    android:textSize="12sp" />

                <Chronometer
                    android:id="@+id/hu_widget_remaining"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/hu_widget_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/hu_widget_previous"
                android:src="@drawable/hu_widget_icon_previous"
                android:tint="@color/hu_widget_text"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="11dp"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/hu_widget_play"
                android:src="@drawable/hu_widget_icon_play"
                android:tint="@color/hu_widget_bg"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/hu_widget_play"
                android:padding="15dp"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/hu_widget_next"
                android:src="@drawable/hu_widget_icon_next"
                android:tint="@color/hu_widget_text"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="11dp"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hu_widget_open"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/hu_widget_logo"
            android:tint="@color/hu_widget_logo"
            android:layout_width="36dp"
            android:layout_height="36dp" />

        <TextView
            android:id="@+id/hu_widget_open_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/hu_widget_text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
